// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  passwordHash        String
  totpSecretEncrypted String?
  totpEnabled         Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  transactions          Transaction[]
  categories            Category[]
  budgets               Budget[]
  authenticators        Authenticator[]
  categoryRules         CategoryRule[]
  recurringTransactions RecurringTransaction[]
  invoices              Invoice[]
}

model Authenticator {
  id                   String    @id @default(uuid())
  credentialId         String    @unique
  publicKey            Bytes
  counter              BigInt    @default(0)
  transports           String[]
  credentialDeviceType String?
  credentialBackedUp   Boolean   @default(false)
  deviceName           String?
  createdAt            DateTime  @default(now())
  lastUsedAt           DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Transaction {
  id          String   @id @default(uuid())
  amount      Int // Stored in Cents
  description String
  date        DateTime @default(now())
  avoidable   Boolean  @default(false) // user-flagged: this specific booking could have been avoided
  inefficient Boolean  @default(false) // user-flagged: this specific booking was a bad deal (e.g. bad banking fees)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
}

model Category {
  id   String @id @default(uuid())
  name String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  transactions          Transaction[]
  budgets               Budget[]
  categoryRules         CategoryRule[]
  recurringTransactions RecurringTransaction[]
}

model Budget {
  id     String   @id @default(uuid())
  amount Int // Stored in Cents
  month  DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
}

model CategoryRule {
  id        String   @id @default(uuid())
  matchText String // normalized (trim+lowercase) transaction description
  useCount  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, matchText])
  @@index([userId])
}

model RecurringTransaction {
  id             String    @id @default(uuid())
  amount         Int // Stored in Cents; positive = income, negative = expense
  description    String
  nextDueDate    DateTime // next calendar date to post; anchors which month a yearly/quarterly rule falls on
  intervalMonths Int       @default(1) // e.g. 1 = monthly, 3 = quarterly (GEZ), 12 = yearly (car tax, ADAC)
  active         Boolean   @default(true)
  avoidable      Boolean   @default(false) // user-flagged: this recurring rule could be cancelled/avoided
  inefficient    Boolean   @default(false) // user-flagged: this recurring rule is a bad deal (e.g. bad banking fees)
  lastRunAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  @@index([userId])
}

model Invoice {
  id          String   @id @default(uuid())
  filename    String // original filename, shown to the user
  mimeType    String
  size        Int // bytes
  storagePath String // filename on disk (random, not user-controlled) under the invoices upload dir
  important   Boolean  @default(false) // exempts this invoice from the 30-day auto-delete
  uploadedAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
