// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  passwordHash        String
  totpSecretEncrypted String?
  totpEnabled         Boolean  @default(false)
  monthStartDay       Int      @default(1) // 1-31; day the user's financial month begins (e.g. 23 = salary day)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  accounts              Account[]
  transactions          Transaction[]
  categories            Category[]
  budgets               Budget[]
  authenticators        Authenticator[]
  categoryRules         CategoryRule[]
  recurringTransactions RecurringTransaction[]
  invoices              Invoice[]
  savingsPots           SavingsPot[]
  pushSubscriptions     PushSubscription[]
}

enum AccountType {
  CHECKING // Girokonto
  SAVINGS // Sparkonto/Tagesgeld
  CASH // Bargeld
  OTHER
}

// A real bank/cash account with its own balance. Replaces the old single implicit
// User.startingBalance — every user gets at least one (created by the accounts migration for
// existing users, seeded with their old startingBalance).
model Account {
  id              String      @id @default(uuid())
  name            String // e.g. "Girokonto", "Tagesgeld", "Bargeld"
  type            AccountType @default(CHECKING)
  startingBalance Int         @default(0) // Cents; opening balance before any tracked transactions existed
  archived        Boolean     @default(false) // hidden from pickers/totals but kept for historical transactions
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]

  @@index([userId])
}

model Authenticator {
  id                   String    @id @default(uuid())
  credentialId         String    @unique
  publicKey            Bytes
  counter              BigInt    @default(0)
  transports           String[]
  credentialDeviceType String?
  credentialBackedUp   Boolean   @default(false)
  deviceName           String?
  createdAt            DateTime  @default(now())
  lastUsedAt           DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Transaction {
  id               String   @id @default(uuid())
  amount           Int // Stored in Cents
  description      String
  date             DateTime @default(now())
  avoidable        Boolean  @default(false) // user-flagged: this specific booking could have been avoided
  inefficient      Boolean  @default(false) // user-flagged: this specific booking was a bad deal (e.g. bad banking fees)
  tooExpensive     Boolean  @default(false) // user-flagged: this specific booking costs more than it should (overpriced)
  taxRelevant      Boolean  @default(false) // user-flagged: relevant for the yearly tax filing (drives the filtered tax export)
  isReconciliation Boolean  @default(false) // system-generated balance-adjustment booking from "Saldo abgleichen", not a real-world transaction
  splitGroupId     String? // shared id across sibling rows created by one "split into categories" action; null for ordinary transactions
  tags             String[] @default([]) // free-form hashtags (e.g. "Urlaub2026") for cross-category evaluation, stored without the leading '#'

  // Umbuchung between two of the user's own accounts: a linked pair of rows sharing one
  // transferGroupId (one negative leg in the source account, one positive leg in the destination
  // account) with isTransfer=true. Not real income/expense — excluded from every income/expense,
  // Sparquote, 50/30/20 and category-share calculation, but each leg still moves its account's
  // balance correctly.
  isTransfer      Boolean @default(false)
  transferGroupId String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  @@index([splitGroupId])
  @@index([transferGroupId])
  @@index([accountId])
}

enum BudgetType {
  NEEDS
  WANTS
  SAVINGS
}

model Category {
  id         String      @id @default(uuid())
  name       String
  budgetType BudgetType? // optional 50/30/20-rule classification; unset categories are excluded from that breakdown

  userId String
  user   User   @relation(fields: [userId], references: [id])

  transactions          Transaction[]
  budgets               Budget[]
  categoryRules         CategoryRule[]
  recurringTransactions RecurringTransaction[]
}

model Budget {
  id     String   @id @default(uuid())
  amount Int // Stored in Cents
  month  DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
}

model CategoryRule {
  id        String   @id @default(uuid())
  matchText String // normalized (trim+lowercase) transaction description
  useCount  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, matchText])
  @@index([userId])
}

model RecurringTransaction {
  id             String    @id @default(uuid())
  amount         Int // Stored in Cents; positive = income, negative = expense
  description    String
  nextDueDate    DateTime // next calendar date to post; anchors which month a yearly/quarterly rule falls on
  intervalMonths Int       @default(1) // e.g. 1 = monthly, 3 = quarterly (GEZ), 12 = yearly (car tax, ADAC)
  active         Boolean   @default(true)
  avoidable      Boolean   @default(false) // user-flagged: this recurring rule could be cancelled/avoided
  inefficient    Boolean   @default(false) // user-flagged: this recurring rule is a bad deal (e.g. bad banking fees)
  tooExpensive   Boolean   @default(false) // user-flagged: this recurring rule costs more than it should (overpriced)
  lastRunAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Contract metadata (optional; only meaningful for actual fixed-term contracts, e.g. internet/insurance)
  contractNumber         String?
  contractEndDate        DateTime? // minimum term end date; the contract auto-renews if not cancelled in time
  cancellationPeriodDays Int? // how many days' notice is required before contractEndDate to cancel

  // Price-increase tracking: snapshot of `amount` right before the user last changed it (set by
  // the service on update, not user-editable directly). Cleared back to null via the dedicated
  // dismiss endpoint once the user has acknowledged the increase.
  previousAmount Int?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  @@index([userId])
  @@index([accountId])
}

model SavingsPot {
  id          String   @id @default(uuid())
  name        String // e.g. "Notgroschen", "Kfz-Steuer", "Urlaub"
  amountCents Int      @default(0) // Cents currently set aside in this pot; locked away from availableIncome
  targetCents Int? // Optional savings goal, cents; purely informational (progress display)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Invoice {
  id          String   @id @default(uuid())
  filename    String // original filename, shown to the user
  mimeType    String
  size        Int // bytes
  storagePath String // filename on disk (random, not user-controlled) under the invoices upload dir
  important   Boolean  @default(false) // exempts this invoice from the 30-day auto-delete
  uploadedAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique // uniquely identifies one browser/device subscription; also the dedup key on re-subscribe
  p256dh    String // PushSubscriptionJSON.keys.p256dh
  auth      String // PushSubscriptionJSON.keys.auth
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
