# Local dev: matches the `postgres` service in docker-compose.yml.
# When running the backend outside Docker (e.g. `npm run start:dev`), use localhost instead:
# DATABASE_URL="postgresql://postgres_user:secure_password_123@localhost:5432/finance_db?schema=public"
DATABASE_URL="postgresql://postgres_user:secure_password_123@postgres:5432/finance_db?schema=public"

PORT=3000

# Redis: matches the `redis` service in docker-compose.yml.
# When running the backend outside Docker (e.g. `npm run start:dev`), use localhost instead:
# REDIS_URL="redis://localhost:6379"
REDIS_URL="redis://redis:6379"

# Random secret used to sign JWTs. Generate a fresh one per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="e9183c90785240f397fd43548a02a4f2a364feeed9e531056349baf5ea47ea96159b1b3b66d926e1e3de690cc98043d4"
JWT_EXPIRES_IN="7d"

# Any string works (it's hashed to 32 bytes internally) — used to encrypt the TOTP secret at rest.
TOTP_ENCRYPTION_KEY="replace-with-a-long-random-secret"

# Set to "true" once the app is served over HTTPS (prod). Keep "false" for local HTTP dev.
COOKIE_SECURE="false"

# WebAuthn (passkeys) relying party config — must match the domain/origin the frontend is served from.
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="Finanzplaner"
WEBAUTHN_ORIGIN="http://localhost:5173"

# Consumed only by `prisma/seed.ts` to create the single app user.
SEED_USER_EMAIL="kniepertsebastian@gmail.com"
SEED_USER_PASSWORD="FoaTi6ieL5aing6Ae2"
UPLOADS_DIR="./uploads/invoices"

# Web Push (budget-overrun / upcoming-large-transaction notifications). Generate a keypair with:
#   npx web-push generate-vapid-keys
# Leave both unset to disable push notifications entirely (no error — the feature just no-ops).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
